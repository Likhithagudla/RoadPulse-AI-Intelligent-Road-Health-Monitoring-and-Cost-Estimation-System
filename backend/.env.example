# ============================================================
# RoadPulse AI - Environment Configuration Template
# Copy this file to .env and configure production credentials
# ============================================================

# Security & Authentication
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite:///./road_ai.db
# DATABASE_URL=postgresql://road_user:road_password@localhost:5432/road_ai

# Environment & Debug
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=*

# Rate Limiting & Abuse Prevention
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Regional Cost Schedule (Options: Default, Delhi, Maharashtra, Karnataka, Tamil Nadu, Gujarat, Telangana, Uttar Pradesh, West Bengal)
DEFAULT_SOR_REGION=Default

# Paths (Relative to backend root or absolute)
UPLOAD_DIR=../uploads
DASHBOARD_DIR=../dashboard
