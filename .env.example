# ==============================================================================
# RoadPulse AI – Intelligent Road Health Monitoring & Cost Estimation System
# Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root or `backend/` and configure for your environment.
# NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Production Secret Key (Mandatory in production; generate via: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
REQUIRE_PASSWORD_COMPLEXITY=true
MIN_PASSWORD_LENGTH=8

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
# Environment mode: development, staging, production, test
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="RoadPulse AI"
VERSION=2.0.0
API_V1_STR=/api

# Allowed CORS Origins (comma-separated or wildcard for local dev)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite Default (Local Development):
DATABASE_URL=sqlite:///./road_ai.db

# PostgreSQL Production (Recommended for high concurrency / multi-instance):
# DATABASE_URL=postgresql://roadpulse_user:secure_pg_password@localhost:5432/roadpulse_db

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & SECURITY DEFENSE
# ------------------------------------------------------------------------------
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 5. REGIONAL REPAIR COST SCHEDULE OF RATES (SOR)
# ------------------------------------------------------------------------------
# Options: Default, Delhi, Maharashtra, Karnataka, Tamil Nadu, Gujarat,
# Telangana, Uttar Pradesh, West Bengal
DEFAULT_SOR_REGION=Default

# ------------------------------------------------------------------------------
# 6. STORAGE & ASSET PATHS (Relative or Absolute)
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
DASHBOARD_DIR=./dashboard
AI_MODELS_DIR=./ai_models
